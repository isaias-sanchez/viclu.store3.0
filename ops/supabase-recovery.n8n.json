{
  "name": "VICLU - Supabase: actividad y recuperacion automatica",
  "nodes": [
    {
      "id": "Cada 15 minutos",
      "name": "Cada 15 minutos",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 15
            }
          ]
        }
      }
    },
    {
      "id": "Estado Supabase",
      "name": "Estado Supabase",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        0
      ],
      "parameters": {
        "url": "https://api.supabase.com/v1/projects/mvvmmewieigfslvqroia",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 15000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "CONFIGURE_MANAGEMENT_CREDENTIAL",
          "name": "VICLU Supabase Management"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "id": "Decidir Recuperacion",
      "name": "Decidir Recuperacion",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        0
      ],
      "parameters": {
        "jsCode": "const decide = function recoveryDecision(project, expectedRef) {\n  if ((project.ref || project.id) !== expectedRef) throw new Error('Unexpected Supabase project.');\n  const status = project.status;\n  if (status === 'INACTIVE') return { projectRef: expectedRef, status, action: 'restore' };\n  if (status === 'ACTIVE_HEALTHY') return { projectRef: expectedRef, status, action: 'probe' };\n  if (['COMING_UP', 'RESTORING', 'RESTARTING', 'UPGRADING', 'RESIZING', 'PAUSING', 'GOING_DOWN'].includes(status)) {\n    return { projectRef: expectedRef, status, action: 'wait' };\n  }\n  throw new Error(`Supabase requires attention: ${String(status)}`);\n};\nreturn [{ json: decide($json, 'mvvmmewieigfslvqroia') }];"
      }
    },
    {
      "id": "Esta Pausado",
      "name": "Esta Pausado",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        720,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "Esta Pausado",
              "leftValue": "={{ $json.action }}",
              "rightValue": "restore",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "Reactivar Proyecto",
      "name": "Reactivar Proyecto",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        960,
        -240
      ],
      "parameters": {
        "url": "https://api.supabase.com/v1/projects/mvvmmewieigfslvqroia/restore",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 15000
        },
        "method": "POST"
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "CONFIGURE_MANAGEMENT_CREDENTIAL",
          "name": "VICLU Supabase Management"
        }
      }
    },
    {
      "id": "Reactivacion Solicitada",
      "name": "Reactivacion Solicitada",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        -240
      ],
      "parameters": {
        "jsCode": "return [{ json: { outcome: 'restore_requested', checkedAt: new Date().toISOString(), note: 'La siguiente comprobacion verificara la disponibilidad.' } }];"
      }
    },
    {
      "id": "Esta Disponible",
      "name": "Esta Disponible",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        960,
        120
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "Esta Disponible",
              "leftValue": "={{ $json.action }}",
              "rightValue": "probe",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "Consultar Catalogo",
      "name": "Consultar Catalogo",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1200,
        0
      ],
      "parameters": {
        "url": "https://mvvmmewieigfslvqroia.supabase.co/rest/v1/products?select=id&limit=1",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 15000,
          "response": {
            "response": {
              "fullResponse": true,
              "responseFormat": "json"
            }
          }
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "CONFIGURE_CATALOG_CREDENTIAL",
          "name": "VICLU Supabase Public Catalog"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "id": "Verificar Catalogo",
      "name": "Verificar Catalogo",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1440,
        0
      ],
      "parameters": {
        "jsCode": "const validate = function validateCatalog(response) {\n  if (response.statusCode !== 200 || !Array.isArray(response.body)\n      || response.body.some(row => !row || typeof row.id !== 'string')) {\n    throw new Error('The public product catalog did not return a valid database response.');\n  }\n  return { outcome: 'healthy', checkedAt: new Date().toISOString() };\n};\nreturn [{ json: validate($json) }];"
      }
    },
    {
      "id": "Esperar Transicion",
      "name": "Esperar Transicion",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        240
      ],
      "parameters": {
        "jsCode": "return [{ json: { outcome: 'waiting', status: $json.status, checkedAt: new Date().toISOString() } }];"
      }
    }
  ],
  "connections": {
